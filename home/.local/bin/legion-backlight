#!/usr/bin/env bash
set -uo pipefail

# Lenovo Legion firmware dims the panel when the dGPU loses power (D3cold) or
# the platform profile changes, without touching the brightness value. Writing
# the value again makes it take effect; the firmware needs a different value in
# between, and now and then a second try. sysfs sends no change events for
# either file, so they are polled: fast only while the GPU is awake, to catch the
# moment it sleeps before the eye does. --once restores the panel and exits.

nudge() {
    local cur
    cur="$(brightnessctl -c backlight get)" || return 0
    brightnessctl -q -c backlight set "$((cur > 0 ? cur - 1 : 1))"
    brightnessctl -q -c backlight set "$cur"
}

restore() {
    nudge
    sleep 0.5
    nudge
}

if [[ "${1:-}" == --once ]]; then
    restore
    exit 0
fi

# What loses its power: the dGPU, or with the card off the bus (dgpu off) the empty bridge
# it hung from, which still sleeps again after anything reads the bus (btop, lspci).
power_dir=
for dev in /sys/bus/pci/devices/*; do
    [[ "$(<"$dev/vendor")" == 0x10de ]] && power_dir=$dev/power && break
done
# The bridge is awake for only ~0.2 s: polled often, and its active time shows a wake missed.
idle_wait=2
if [[ -z "$power_dir" ]]; then
    for port in /sys/bus/pci/devices/*; do
        [[ -r "$port/secondary_bus_number" ]] || continue
        printf -v bus '%02x' "$(<"$port/secondary_bus_number")"
        name=${port##*/}
        compgen -G "/sys/bus/pci/devices/${name%%:*}:$bus:*" >/dev/null && continue
        power_dir=$port/power idle_wait=0.1
        break
    done
fi
gpu_file=${power_dir:-/nonexistent}/runtime_status
active_file=${power_dir:-/nonexistent}/runtime_active_time
profile_file=/sys/firmware/acpi/platform_profile

# The panel dims once more after login.
sleep 4
restore

# A read with a timeout on this is a sleep without a process.
exec 3<> <(:)

read -r gpu <"$gpu_file" || gpu=
read -r active <"$active_file" || active=
read -r profile <"$profile_file" || profile=
while :; do
    gpu_was=$gpu active_was=$active profile_was=$profile
    read -r gpu <"$gpu_file" || gpu=
    read -r active <"$active_file" || active=
    read -r profile <"$profile_file" || profile=
    # It dims as the power is cut: within a frame or two of that, then again in case the
    # firmware was not done yet.
    if [[ "$gpu" == suspended && ( "$gpu_was" != suspended || "$active" != "$active_was" ) ]]; then
        nudge
        sleep 0.15
        nudge
        sleep 0.35
        nudge
    # A new profile dims it a few seconds later.
    elif [[ "$profile" != "$profile_was" ]]; then
        sleep 12
        restore
    fi
    # Only a GPU that is awake can lose its power, and it is rarely awake; with nothing to
    # watch, only the profile.
    if [[ "$gpu" == suspended || -z "$power_dir" ]]; then
        read -r -t "$idle_wait" -u 3 _ || true
    else
        read -r -t 0.02 -u 3 _ || true
    fi
done
