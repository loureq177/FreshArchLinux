# libfprint with the Touch OEM Drivers interface (Ubuntu's), which the Elan driver plugs
# into: Arch's libfprint PKGBUILD on Marco Trevisan's signed tags.

pkgname=libfprint-tod
_pkgdirname=libfprint
pkgver=1.95.2+tod1
pkgrel=1
pkgdesc="Library for fingerprint readers - TOD version"
url="https://gitlab.freedesktop.org/3v1n0/libfprint"
arch=('x86_64')
license=('LGPL-2.1-or-later')
depends=(gcc-libs glib2 glibc libgudev libgusb nss pixman)
makedepends=(git glib2-devel gobject-introspection gtk-doc meson python-cairo python-gobject systemd)
provides=(libfprint libfprint-2.so libfprint-2-tod.so)
conflicts=(libfprint)
source=("git+$url.git?signed#tag=v$pkgver")
sha256sums=('SKIP')
validpgpkeys=('D4C501DA48EB797A081750939449C2F50996635F') # Marco Trevisan (Treviño) <mail@3v1n0.net>
options=('!lto' '!debug')

# The newest TOD tag (sysupdate asks).
_latest() {
    git ls-remote --tags --refs "$url.git" 'v*+tod*' | sed -nE 's#.*refs/tags/v##p' | sort -V | tail -n 1
}

build() {
    arch-meson $_pkgdirname build -D drivers=all -D installed-tests=false
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
}
